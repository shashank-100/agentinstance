{
  "name": "agentinstance",
  "version": "0.1.0",
  "description": "Open-source, self-hostable always-on AI agents on Cloudflare. Any harness, any model, persistent memory, many channels.",
  "type": "module",
  "bin": {
    "agentinstance": "./cli/agentinstance.mjs"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:all": "vitest run && vitest run --config vitest.ui.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.12.9"
  }
}
