{
  "name": "nimbus",
  "version": "0.1.0",
  "description": "Open-source, self-hostable always-on AI agents on Cloudflare. Any harness, any model, persistent memory, many channels.",
  "type": "module",
  "bin": {
    "nimbus": "./cli/nimbus.mjs"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:all": "vitest run && vitest run --config vitest.ui.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.90.0"
  }
}
