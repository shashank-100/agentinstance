# Copy to .dev.vars for local dev (never commit .dev.vars).
# In production, set these with `wrangler secret put <NAME>`.

# Models: no LLM provider is configured. Add a Model adapter in
# src/models/index.ts (and its key here) before agents can reply.

# Channels
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Capabilities
TAVILY_API_KEY=

# Self-hostable sandbox (agents run real commands)
SANDBOX_URL=
SANDBOX_TOKEN=
