{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentinstance",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Headless Chrome for JS-heavy pages that scrape_web cannot read.
  // A binding, not an image: no Chromium in the container.
  "browser": { "binding": "BROWSER", "remote": true },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // The sandbox runs as a container attached to its own Durable Object, so
  // each agent gets an isolated workspace addressed the same way its memory is.
  //
  // One class per machine tier, because `instance_type` is fixed per container
  // class — it cannot be chosen per request. Three classes over the same image
  // is what makes the builder's machine picker mean anything; with a single
  // class every tier booted identical hardware whatever the UI charged.
  // Containers are placed in the nearest available datacenter, which made the
  // agent's success depend on where its VM happened to boot: one in Hong Kong
  // got `403 Request not allowed` from Anthropic, one in Tokyo worked, with no
  // difference in code or credentials. APAC cannot be narrowed — it covers both
  // — so placement is pinned to North America and Europe, every part of which
  // Anthropic serves. The cost is latency from Asia; the alternative is agents
  // that fail at random.
  "containers": [
    { "class_name": "SandboxSmall",  "image": "./Dockerfile", "instance_type": "standard-1", "max_instances": 20,
      "constraints": { "regions": ["ENAM", "WNAM", "WEUR", "EEUR"] } },
    { "class_name": "SandboxMedium", "image": "./Dockerfile", "instance_type": "standard-2", "max_instances": 20,
      "constraints": { "regions": ["ENAM", "WNAM", "WEUR", "EEUR"] } },
    { "class_name": "SandboxLarge",  "image": "./Dockerfile", "instance_type": "standard-3", "max_instances": 20,
      "constraints": { "regions": ["ENAM", "WNAM", "WEUR", "EEUR"] } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AGENT", "class_name": "AgentInstance" },
      { "name": "REGISTRY", "class_name": "RegistryDO" },
      { "name": "FLEET", "class_name": "FleetDO" },
      { "name": "SANDBOX_SMALL", "class_name": "SandboxSmall" },
      { "name": "SANDBOX_MEDIUM", "class_name": "SandboxMedium" },
      { "name": "SANDBOX_LARGE", "class_name": "SandboxLarge" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AgentInstance", "RegistryDO"] },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] },
    // The single Sandbox class is replaced by one per tier. Agents on the old
    // class keep no state worth moving: a container's filesystem is discarded
    // when it sleeps, so there is nothing to migrate, only to re-create.
    { "tag": "v3", "deleted_classes": ["Sandbox"],
      "new_sqlite_classes": ["SandboxSmall", "SandboxMedium", "SandboxLarge"] },
    // The work queue: tasks outlive the request that filed them.
    { "tag": "v4", "new_sqlite_classes": ["FleetDO"] }
  ],
  // WORKER_URL is deliberately unset: the Worker takes its own address from
  // the request it is serving, so every deployment calls its own tools back.
  // A value hardcoded here would be baked into the tool scripts inside every
  // user's VM, pointing their agents at whichever deployment it named.
  //
  // Set it only when the public URL differs from the request host — behind a
  // proxy, or on a custom domain:
  //   "vars": { "WORKER_URL": "https://agents.example.com" }
  // Secrets (set via `wrangler secret put`):
  //   CLAUDE_CODE_OAUTH_TOKEN (claude-code), MOONSHOT_API_KEY, TAVILY_API_KEY (search_web)
}
